parameters:

  header:
    title: Homogeneous Acoustic Kernel (3D) - Combined Simulation
    description: |
      Material systems : Acoustic domain (1)
      Interfaces : None
      Sources : Force source (1) + Adjoint source at X20 (1)
      Boundary conditions : Dirichlet (free surface) on top
      Receivers : Pressure seismograms
      Output : Sensitivity kernels (rho_kernel, alpha_kernel)
      Reference : Tromp, Tape & Liu (GJI 2005)

  run-setup:
    number-of-processors: 1
    number-of-runs: 1

  databases:
    mesh-database: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/DATABASES/Database.bin"

  sources: "@CURRENT_BENCHMARK_BUILD_DIR@/adjoint_source.yaml"

  simulation-setup:
    quadrature:
      quadrature-type: GLL4

    simulation-mode:
      combined:
        reader:
          wavefield:
            directory: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES"
            format: npy

        writer:
          kernels:
            directory: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES"
            format: npy

    solver:
      time-marching:
        time-scheme:
          type: Newmark
          dt: 0.2
          nstep: 500

  receivers:
    stations: "@CURRENT_BENCHMARK_BUILD_DIR@/DATA/STATIONS"
    angle: 0.0
    seismogram-type:
      - pressure
    nstep_between_samples: 1

  log-file: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/output_adjoint"
