parameters:

  header:
    title: Homogeneous Acoustic Kernel (3D) - Adjoint MPI
    description: |
      Material systems : Acoustic domain (1)
      Interfaces : None
      Sources : Adjoint source (1)
      Boundary conditions : Neumann BCs on all edges
      Output : Sensitivity kernels

  simulation-setup:
    quadrature:
      quadrature-type: GLL4

    solver:
      time-marching:
        time-scheme:
          type: Newmark
          dt: 0.16
          nstep: 400

    simulation-mode:
      combined:
        reader:
          wavefield:
            format: NPY
            directory: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/ForwardWavefield"
        writer:
          # display:
          #   format: VTKHDF
          #   directory: @CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/vtk/
          #   field: displacement
          #   simulation-field: adjoint
          #   time-interval: 5
          kernels:
            format: NPY
            directory: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/kernels"

  receivers:
    stations: "@CURRENT_BENCHMARK_BUILD_DIR@/DATA/STATIONS"
    angle: 0.0
    seismogram-type:
      - pressure
    nstep_between_samples: 1

  run-setup:
    number-of-processors: 6
    number-of-runs: 1

  databases:
    mesh-database: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/DATABASES/Database.bin"

  sources:
    YAML:
      - "@CURRENT_BENCHMARK_BUILD_DIR@/forward_source.yaml"
      - "@CURRENT_BENCHMARK_BUILD_DIR@/adjoint_source.yaml"

  log-file: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/output_adjoint"
