#-----------------------------------------------------------
#
# Meshing input parameters
#
#-----------------------------------------------------------

MESH_A_CHUNK_OF_THE_EARTH        = .false.
CHUNK_MESH_PAR_FILE              = dummy.txt

# coordinates of mesh block in latitude/longitude and depth in km
# (using Cartesian projection: SUPPRESS_UTM_PROJECTION = .true.)
# Domain: 134444 m x 134444 m x 60 km depth (homogeneous acoustic halfspace)
LATITUDE_MIN                    = 0.0
LATITUDE_MAX                    = 134444.0
LONGITUDE_MIN                   = 0.0
LONGITUDE_MAX                   = 134444.0
DEPTH_BLOCK_KM                  = 60.d0
UTM_PROJECTION_ZONE             = 11
SUPPRESS_UTM_PROJECTION         = .true.

# file that contains the interfaces of the model / mesh
INTERFACES_FILE                 = @CURRENT_BENCHMARK_BUILD_DIR@/DATA/meshfem3D_files/interfaces.txt

# file that contains the cavity
CAVITY_FILE                     = no_cavity.dat

# Number of nodes for 2D and 3D shape functions for hexahedra.
NGNOD                           = 8

# number of elements at the surface along edges of the mesh
NEX_XI                          = 18
NEX_ETA                         = 18

# number of MPI processors along xi and eta
NPROC_XI                        = 1
NPROC_ETA                       = 1

#-----------------------------------------------------------
#
# Doubling layers
#
#-----------------------------------------------------------

# Regular/irregular mesh
USE_REGULAR_MESH                = .true.
NDOUBLINGS                      = 0
NZ_DOUBLING_1                   = 40
NZ_DOUBLING_2                   = 48

#-----------------------------------------------------------
#
# Visualization
#
#-----------------------------------------------------------

CREATE_ABAQUS_FILES             = .false.
CREATE_DX_FILES                 = .false.
CREATE_VTK_FILES                = .true.
SAVE_MESH_AS_CUBIT              = .false.

# path to store the database files
LOCAL_PATH                      = @CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/DATABASES

#-----------------------------------------------------------
#
# CPML
#
#-----------------------------------------------------------

THICKNESS_OF_X_PML              = 12.3d0
THICKNESS_OF_Y_PML              = 12.3d0
THICKNESS_OF_Z_PML              = 12.3d0

#-----------------------------------------------------------
#
# Domain materials
#
#-----------------------------------------------------------

# number of materials
NMATERIALS                      = 1
# #material_id  #rho  #vp  #vs  #Q_Kappa  #Q_mu  #anisotropy_flag  #domain_id
#   domain_id: 1 = acoustic / 2 = elastic
1   2300.0   2800.0   0.0  9999  9999  0  1

#-----------------------------------------------------------
#
# Domain regions
#
#-----------------------------------------------------------

# number of regions
NREGIONS                        = 1
# #NEX_XI_BEGIN  #NEX_XI_END  #NEX_ETA_BEGIN  #NEX_ETA_END  #NZ_BEGIN #NZ_END  #material_id
1               18            1               18            1         8        1
