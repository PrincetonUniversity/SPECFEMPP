parameters:

  header:
    ## Header information is used for logging. It is good practice to give your simulations explicit names
    title: Isotropic Cosserat simulation # name for your simulation
    # A detailed description for your simulation
    description: |
      Material systems : Elastic Cosserat domain (1)
      Interfaces : None
      Sources : Cosserat force source (1)
      Boundary conditions : Neumann BCs on all edges

  simulation-setup:
    ## quadrature setup
    quadrature:
      quadrature-type: GLL4

    ## Solver setup
    solver:
      time-marching:
        time-scheme:
          type: Newmark
          dt: 0.1
          nstep: 425

    simulation-mode:
      forward:
        writer:
          seismogram:
            format: "ascii"
            directory: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/results"

          ## Uncomment to write rotation wavefield snapshots (requires an
          ## HDF5-enabled build); also uncomment the wavefield.vtkhdf lines
          ## in the Snakefile to wire the file into the workflow.
          # display:
          #   format: vtkhdf
          #   directory: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/vtk"
          #   field: rotation
          #   component: magnitude
          #   simulation-field: forward
          #   time-interval: 10

  receivers:
    stations: "@CURRENT_BENCHMARK_BUILD_DIR@/DATA/STATIONS"
    angle: 0.0
    seismogram-type:
      - displacement
      - rotation
      - intrinsic_rotation
      - curl
    nstep_between_samples: 1

  ## Runtime setup
  run-setup:
    number-of-processors: 1
    number-of-runs: 1

  ## databases
  databases:
    mesh-database: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/DATABASES/Database.bin"

  ## sources
  sources: "@CURRENT_BENCHMARK_BUILD_DIR@/source.yaml"

  ## log-file configuration
  log-file: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/output"
