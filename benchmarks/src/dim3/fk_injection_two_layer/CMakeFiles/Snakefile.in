SPECFEM_BIN = "@CMAKE_BINARY_DIR@/bin/specfem 3d"
MESHFEM_BIN = "@CMAKE_BINARY_DIR@/bin/xmeshfem3D"
FK_PLUGIN = "@CMAKE_BINARY_DIR@/lib/libfk_injection.so"
BENCHMARK_DIR = "@CURRENT_BENCHMARK_BUILD_DIR@"


rule all:
    input:
        BENCHMARK_DIR + "/OUTPUT_FILES/comparison.txt",
        BENCHMARK_DIR + "/OUTPUT_FILES/comparison.png",
    localrule: True


rule generate_mesh:
    input:
        BENCHMARK_DIR + "/DATA/meshfem3D_files/Mesh_Par_file",
    output:
        database=BENCHMARK_DIR + "/OUTPUT_FILES/DATABASES/Database.bin",
    localrule: True
    shell:
        """
            mkdir -p {BENCHMARK_DIR}/OUTPUT_FILES/DATABASES
            {MESHFEM_BIN} -p {input}
        """


rule run_solver:
    input:
        plugin=FK_PLUGIN,
        database=rules.generate_mesh.output.database,
        stations=BENCHMARK_DIR + "/DATA/STATIONS",
        source=BENCHMARK_DIR + "/source.yaml",
        config=BENCHMARK_DIR + "/specfem_config.yaml",
        fk=BENCHMARK_DIR + "/fk.yaml",
    output:
        traces=expand(
            BENCHMARK_DIR
            + "/OUTPUT_FILES/results/TEST.{station}.S3.{component}.{extension}",
            station=list("ABCDEF"),
            component=["MXX", "MXY", "MXZ"],
            extension=["semd", "semv", "sema"],
        ),
        log=BENCHMARK_DIR + "/OUTPUT_FILES/output.log",
    localrule: True
    shell:
        """
            {SPECFEM_BIN} -p {input.config} \
                --injection-plugin {input.plugin} \
                --injection-config {input.fk} > {output.log}
        """


rule compare:
    input:
        rules.run_solver.output.traces,
    output:
        table=rules.all.input[0],
        plot=rules.all.input[1],
    localrule: True
    shell:
        """
            python {BENCHMARK_DIR}/compare_seismograms.py \
                {BENCHMARK_DIR}/OUTPUT_FILES/results \
                {BENCHMARK_DIR}/reference_seismograms \
                {output.table} {output.plot}
        """


rule clean:
    localrule: True
    shell:
        """
            rm -rf {BENCHMARK_DIR}/OUTPUT_FILES
        """
