parameters:

  header:
    title: FK injection, ocean over crust and mantle
    description: |
      Material systems : Ocean (acoustic, 4 km) over oceanic crust (7 km) over the mantle half-space
      Sources : FK plane P wave injected on the Stacey faces by the plugin
      Receivers : Hydrophone at 1500 m depth in the ocean
      Boundary conditions : Stacey and injection on sides and bottom, free surface on top

  simulation-setup:
    quadrature:
      quadrature-type: GLL4

    solver:
      time-marching:
        time-scheme:
          type: Newmark
          dt: 0.005
          nstep: 6000

    simulation-mode:
      forward:
        writer:
          seismogram:
            format: "ascii"
            directory: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/results"

          # display:
          #   format: VTKHDF
          #   directory: @CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/vtk/
          #   field: displacement
          #   simulation-field: forward
          #   time-interval: 5

  receivers:
    stations: "@CURRENT_BENCHMARK_BUILD_DIR@/DATA/STATIONS"
    angle: 0.0
    seismogram-type:
      - pressure
    nstep_between_samples: 1

  run-setup:
    number-of-processors: 1
    number-of-runs: 1

  databases:
    mesh-database: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/DATABASES/Database.bin"

  sources: "@CURRENT_BENCHMARK_BUILD_DIR@/source.yaml"

  injection:
    method: stacey

  log-file: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/output"
