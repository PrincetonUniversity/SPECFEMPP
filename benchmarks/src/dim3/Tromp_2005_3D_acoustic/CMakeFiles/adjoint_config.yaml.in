parameters:

  header:
    description: |
      Material systems : Acoustic domain (1)
      Interfaces : None
      Sources : Force source (1) + Adjoint source (2)
      Boundary conditions : Free surface (1)
      Mesh : 3D Cartesian extrusion of the Tromp_2005 2D benchmark
      Receiver : Pressure seismogram (1)
      Output : Sensitivity kernels (1)

    title: Tromp-Tape-Liu (GJI 2005) - 3D combined simulation

  receivers:
    stations: "@CURRENT_BENCHMARK_BUILD_DIR@/DATA/STATIONS"
    angle: 0.0
    nstep_between_samples: 1
    seismogram-type:
    - pressure

  run-setup:
    number-of-processors: 1
    number-of-runs: 1

  databases:
    mesh-database: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/DATABASES/Database.bin"

  sources: "@CURRENT_BENCHMARK_BUILD_DIR@/adjoint_source.yaml"

  simulation-setup:
    quadrature:
      quadrature-type: GLL4

    simulation-mode:
      combined:
        reader:
          wavefield:
            directory: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES"
            format: npy

        writer:
          kernels:
            directory: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES"
            format: npy

    solver:
      time-marching:
        time-scheme:
          dt: 0.02
          nstep: 2004
          t0: 8.0
          type: Newmark

  log-file: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/output_adjoint"
