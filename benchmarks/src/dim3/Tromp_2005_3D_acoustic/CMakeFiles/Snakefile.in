SPECFEM_BIN = "@CMAKE_BINARY_DIR@/bin/specfem 3d"
MESHFEM_BIN = "@CMAKE_BINARY_DIR@/bin/xmeshfem3D"
ADJ_SEISMOGRAM_BIN = "@CMAKE_BINARY_DIR@/bin/xadj_seismogram"


rule all:
    input:
        plot="@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/Kernels.png",


rule generate_mesh:
    input:
        "@CURRENT_BENCHMARK_BUILD_DIR@/DATA/meshfem3D_files/Mesh_Par_file",
    output:
        database="@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/DATABASES/Database.bin",
        mesh_vtk="@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/DATABASES/mesh.vtk",
    localrule: True
    shell:
        """
            mkdir -p @CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/DATABASES
            {MESHFEM_BIN} -p {input}
        """


rule forward_simulation:
    input:
        database=rules.generate_mesh.output.database,
        stations="@CURRENT_BENCHMARK_BUILD_DIR@/DATA/STATIONS",
        source="@CURRENT_BENCHMARK_BUILD_DIR@/forward_source.yaml",
        config="@CURRENT_BENCHMARK_BUILD_DIR@/forward_config.yaml",
    output:
        seismograms=expand(
            "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/results/{network_name}.{station_name}.S3.{component}.semp",
            station_name=["S0001"],
            network_name=["AA"],
            component=["BXP"],
        ),
        forward_wavefield=directory("@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/ForwardWavefield"),
        log="@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/output_forward.log",
    resources:
        nodes=1,
        tasks=1,
        cpus_per_task=1,
        runtime=30,
    shell:
        """
            mkdir -p @CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/results
            echo "Hostname: $(hostname)" > {output.log}
            {SPECFEM_BIN} -p {input.config} >> {output.log}
        """


rule compute_adjoint_source_p:
    input:
        seismogram="@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/results/AA.S0001.S3.BXP.semp",
    output:
        adjoint_source="@CURRENT_BENCHMARK_BUILD_DIR@/adjoint_sources/AA.S0001.S3.BXP.adj",
    run:
        import numpy as np
        import os

        os.makedirs("@CURRENT_BENCHMARK_BUILD_DIR@/adjoint_sources", exist_ok=True)

        data = np.loadtxt(input.seismogram)
        time = data[:, 0]
        seism = data[:, 1]
        dt = (time[-1] - time[0]) / (len(time) - 1)
        t0 = time[0]
        nstep = len(time)

        # Welch window in the time gate [27.0, 32.0]
        t1, t2 = 27.0, 32.0
        istart = int(np.floor((t1 - t0) / dt))
        iend = int(np.ceil((t2 - t0) / dt))
        istart = max(0, min(istart, nstep - 2))
        iend = max(istart + 1, min(iend, nstep - 1))

        window = np.zeros(nstep)
        for i in range(istart, iend + 1):
            window[i] = 1.0 - (2.0 * (i - istart) / (iend - istart) - 1.0) ** 2

        # Velocity (first derivative)
        veloc = np.zeros(nstep)
        veloc[1:-1] = (seism[2:] - seism[:-2]) / (2 * dt)
        veloc[0] = (seism[1] - seism[0]) / dt
        veloc[-1] = (seism[-1] - seism[-2]) / dt

        # Acceleration (second derivative)
        accel = np.zeros(nstep)
        accel[1:-1] = (veloc[2:] - veloc[:-2]) / (2 * dt)
        accel[0] = (veloc[1] - veloc[0]) / dt
        accel[-1] = (veloc[-1] - veloc[-2]) / dt

        # Cross-correlation traveltime adjoint source (Tromp et al. 2005, eq 45)
        Nnorm = dt * np.sum(window * seism * accel)
        EPS = 1e-30
        if abs(Nnorm) > EPS:
            ft_bar = veloc * window / Nnorm
        else:
            ft_bar = np.zeros(nstep)

        np.savetxt(output.adjoint_source, np.column_stack([time, ft_bar]),
                   fmt="%15.7e %15.7e")


rule adjoint_simulation:
    input:
        database=rules.generate_mesh.output.database,
        stations="@CURRENT_BENCHMARK_BUILD_DIR@/DATA/STATIONS",
        source="@CURRENT_BENCHMARK_BUILD_DIR@/adjoint_source.yaml",
        config="@CURRENT_BENCHMARK_BUILD_DIR@/adjoint_config.yaml",
        adjoint_source_p=rules.compute_adjoint_source_p.output.adjoint_source,
    output:
        kernels=directory("@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/Kernels"),
        log="@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/output_adjoint.log",
    resources:
        nodes=1,
        tasks=1,
        cpus_per_task=1,
        runtime=30,
    shell:
        """
            echo "Hostname: $(hostname)" > {output.log}
            {SPECFEM_BIN} -p {input.config} >> {output.log}
        """


rule plot_kernels:
    input:
        kernels="@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/Kernels",
        plot_script="@CURRENT_BENCHMARK_BUILD_DIR@/plot.py",
    output:
        plot="@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/Kernels.png",
    run:
        from plot import plot_kernels

        import matplotlib
        matplotlib.use("Agg")

        plot_kernels(input.kernels, output.plot)


rule clean:
    shell:
        """
            rm -rf @CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES @CURRENT_BENCHMARK_BUILD_DIR@/adjoint_sources
        """
