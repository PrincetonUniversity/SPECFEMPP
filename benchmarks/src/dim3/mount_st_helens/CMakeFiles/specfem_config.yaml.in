parameters:

  header:
    title: 3D Mount St. Helens -- topographic external mesh (Gmsh)
    description: |
      Material systems : Elastic domain (1), vp=2800 vs=1500 rho=2300
      Interfaces : Topographic free surface (Gmsh-warped box)
      Sources : Isotropic explosion (CMTSOLUTION), half duration 1.5 s
      Boundary conditions : Absorbing (xmin, xmax, ymin, ymax, bottom), Free surface (zmax)

  simulation-setup:
    quadrature:
      quadrature-type: GLL4

    solver:
      time-marching:
        time-scheme:
          type: Newmark
          dt: 0.005
          nstep: 2500

    simulation-mode:
      forward:
        writer:
          seismogram:
            format: "ascii"
            directory: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/results"

          # display:
          #   format: VTKHDF
          #   directory: @CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/vtk/
          #   field: displacement
          #   simulation-field: forward
          #   time-interval: 50

  receivers:
    stations: "@CURRENT_BENCHMARK_BUILD_DIR@/DATA/STATIONS"
    seismogram-type:
      - displacement
      - velocity
      - acceleration
    nstep_between_samples: 1

  run-setup:
    number-of-processors: 4
    number-of-runs: 1

  databases:
    mesh-database: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/DATABASES/Database.bin"

  sources:
    CMTSOLUTION: "@CURRENT_BENCHMARK_BUILD_DIR@/DATA/CMTSOLUTION"

  log-file: "@CURRENT_BENCHMARK_BUILD_DIR@/OUTPUT_FILES/output"
