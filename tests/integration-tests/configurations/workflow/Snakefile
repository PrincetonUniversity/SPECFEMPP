configfile: "../dim2/tests.yaml"
configfile: "../tests.yaml"

tests2d = config["tests2d"]
# 3D cases built with one process; the others are built by Snakefile_mpi.
tests3d = [name for name, nproc in config["explicit_solver"].items() if nproc == 1]


rule all:
    input:
        traces2d=expand("../dim2/{test_name}/traces/trace_list.txt", test_name=tests2d),
        database2d=expand("../dim2/{test_name}/database.bin", test_name=tests2d),
        traces3d=expand("../dim3/explicit_solver/{test_name}/traces/trace_list.txt", test_name=tests3d),
        database3d=expand("../dim3/explicit_solver/{test_name}/database.bin", test_name=tests3d),
    localrule: True

# for test_name in config["tests"]:
for test_name in tests2d:
    alias = f'{test_name}_'

    module:
        name: test_name
        snakefile: f"../dim2/{test_name}/Snakefile"
        pathvars:
            cwd=f"../dim2/{test_name}"

    use rule * from test_name as alias*

for test_name in tests3d:
    alias = f'{test_name}_'

    module:
        name: test_name
        snakefile: f"../dim3/explicit_solver/{test_name}/Snakefile"
        pathvars:
            cwd=f"../dim3/explicit_solver/{test_name}"

    use rule * from test_name as alias*

rule clean:
    shell:
        """
        rm -rf ../dim2/*/specfem2d_workdir
        rm -rf ../dim2/*/database.bin
        rm -rf ../dim2/*/traces
        rm -rf ../dim3/explicit_solver/*/specfem3d_workdir
        rm -rf ../dim3/explicit_solver/*/database.bin
        rm -rf ../dim3/explicit_solver/*/traces
        """
