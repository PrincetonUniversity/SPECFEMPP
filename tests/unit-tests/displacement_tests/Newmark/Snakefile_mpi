# Master Snakefile for the MPI Newmark displacement tests (3D only).
#
# Mirrors ./Snakefile but targets mpi/dim3 and produces partitioned per-rank
# databases (database/proc_N.bin). The Fortran reference path (and therefore the
# reference traces) is identical to serial; only the SPECFEM++ mesher is
# partitioned via `cores` (see meshfem3d.smk).
#
# Run from this directory with:
#     snakemake -s Snakefile_mpi --cores <N>
# Requires SPECFEM3D_BINDIR and SPECFEMPP_BINDIR in the environment.

configfile: "mpi/dim3/tests_mpi4.yaml"

tests3d = config["tests3d"]

# Process count for this group. Matches tests_mpi4.yaml and each case's
# config.yaml nproc / Mesh_Par_file NPROC_XI*NPROC_ETA. Add a second master (or
# generalize this one) for other sizes.
cores = 4

rule all:
    input:
        traces3d=expand(
            "mpi/dim3/{test_name}/traces/trace_list.txt", test_name=tests3d
        ),
        database3d=[
            f"mpi/dim3/{test_name}/database/proc_{rank}.bin"
            for test_name in tests3d
            for rank in range(cores)
        ],
    localrule: True

# Dynamically include each per-test Snakefile as a module (matches ./Snakefile).
for test_name in tests3d:
    alias = f"{test_name}_"

    module:
        name: test_name
        snakefile: f"mpi/dim3/{test_name}/Snakefile"
        pathvars:
            cwd=f"mpi/dim3/{test_name}"

    use rule * from test_name as alias*

rule clean:
    shell:
        """
            rm -rf mpi/dim3/*/specfem3d_workdir
            rm -rf mpi/dim3/*/database
            rm -rf mpi/dim3/*/traces
        """
