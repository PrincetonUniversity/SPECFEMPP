import os


envvars:
    "SPECFEMPP_BINDIR",


mesher = os.path.join(os.environ["SPECFEMPP_BINDIR"], "xmeshfem3D_globe")
databases = expand(
    "DATABASES_MPI/proc{rank:06d}_specfempp_database.bin", rank=range(6)
)


rule all:
    input:
        databases,
        "provenance/mesher.yaml",
        "provenance/finalize_mesher.txt",


rule generate_database:
    input:
        par_file="provenance/DATA/Par_file",
        stations="provenance/DATA/STATIONS",
        source="provenance/DATA/CMTSOLUTION",
    output:
        databases=databases,
        log="OUTPUT_FILES/output_mesher.txt",
    threads: 6
    shell:
        """
        mkdir -p DATABASES_MPI OUTPUT_FILES
        cp -R provenance/DATA DATA
        mpiexec -n 6 {mesher} > OUTPUT_FILES/launch.log 2>&1
        rm -rf DATA
        """


rule capture_reference:
    input:
        "OUTPUT_FILES/output_mesher.txt",
    output:
        reference="provenance/mesher.yaml",
        report="provenance/finalize_mesher.txt",
    shell:
        "python capture_reference.py {input} {output.reference} {output.report}"
