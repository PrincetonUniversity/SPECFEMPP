{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "displayName": "Default Release -- SIMD enabled",
      "binaryDir": "build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/release",
        "Kokkos_ARCH_NATIVE": "ON",
        "Kokkos_ENABLE_AGGRESSIVE_VECTORIZATION": "ON",
        "Kokkos_ENABLE_ATOMICS_BYPASS": "ON",
        "SPECFEM_INSTALL": "ON",
        "SPECFEM_BUILD_TESTS": "ON",
        "SPECFEM_ENABLE_SIMD": "ON",
        "SPECFEM_BUILD_BENCHMARKS": "ON",
        "SPECFEM_BENCHMARKS_BUILD_DIR": "${sourceDir}/benchmarks/build/release"
      }
    },
    {
      "name": "release-nosimd",
      "displayName": "Release -- SIMD disabled",
      "binaryDir": "build/release-nosimd",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/release-nosimd",
        "Kokkos_ARCH_NATIVE": "OFF",
        "Kokkos_ENABLE_AGGRESSIVE_VECTORIZATION": "ON",
        "Kokkos_ENABLE_ATOMICS_BYPASS": "ON",
        "SPECFEM_BUILD_TESTS": "ON",
        "SPECFEM_ENABLE_SIMD": "OFF",
        "SPECFEM_INSTALL": "ON",
        "SPECFEM_BUILD_BENCHMARKS": "ON",
        "SPECFEM_BENCHMARKS_BUILD_DIR": "${sourceDir}/benchmarks/build/release-nosimd"
      }
    },
    {
      "name": "release-cuda",
      "displayName": "Release -- CUDA enabled",
      "binaryDir": "build/release-cuda",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/release-cuda",
        "Kokkos_ENABLE_CUDA": "ON",
        "Kokkos_ARCH_NATIVE": "ON",
        "Kokkos_ENABLE_AGGRESSIVE_VECTORIZATION": "ON",
        "Kokkos_ENABLE_ATOMICS_BYPASS": "OFF",
        "SPECFEM_INSTALL": "ON",
        "SPECFEM_BUILD_TESTS": "ON",
        "SPECFEM_BUILD_BENCHMARKS": "ON",
        "SPECFEM_BENCHMARKS_BUILD_DIR": "${sourceDir}/benchmarks/build/release-cuda"
      }
    },
    {
      "name": "release-trilinos",
      "displayName": "Release -- Trilinos implicit solvers (CPU, no MPI)",
      "description": "Inherits 'release' and enables Trilinos. Load trilinos/16.1.0-cpu-native-nompi first so Trilinos_ROOT and Kokkos_ROOT are set in the environment.",
      "inherits": "release",
      "binaryDir": "build/release-trilinos",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/release-trilinos",
        "SPECFEM_ENABLE_TRILINOS": "ON",
        "SPECFEM_BENCHMARKS_BUILD_DIR": "${sourceDir}/benchmarks/build/release-trilinos"
      }
    },
    {
      "name": "release-trilinos-mpi",
      "displayName": "Release -- Trilinos implicit solvers (CPU, MPI)",
      "description": "Inherits 'release-trilinos' and enables MPI. Load trilinos/16.1.0-cpu-native-mpi first so Trilinos_ROOT and Kokkos_ROOT are set in the environment.",
      "inherits": "release-trilinos",
      "binaryDir": "build/release-trilinos-mpi",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/release-trilinos-mpi",
        "SPECFEM_ENABLE_MPI": "ON",
        "SPECFEM_BENCHMARKS_BUILD_DIR": "${sourceDir}/benchmarks/build/release-trilinos-mpi"
      }
    },
    {
      "name": "release-cuda-trilinos",
      "displayName": "Release -- CUDA + Trilinos implicit solvers (no MPI)",
      "description": "Inherits 'release-cuda' and enables Trilinos. Load trilinos/16.1.0-cuda-ampere80-nompi first so Trilinos_ROOT and Kokkos_ROOT are set in the environment.",
      "inherits": "release-cuda",
      "binaryDir": "build/release-cuda-trilinos",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/release-cuda-trilinos",
        "SPECFEM_ENABLE_TRILINOS": "ON",
        "SPECFEM_BENCHMARKS_BUILD_DIR": "${sourceDir}/benchmarks/build/release-cuda-trilinos"
      }
    },
    {
      "name": "release-cuda-trilinos-mpi",
      "displayName": "Release -- CUDA + Trilinos implicit solvers (MPI)",
      "description": "Inherits 'release-cuda-trilinos' and enables MPI. Load trilinos/16.1.0-cuda-ampere80-mpi first so Trilinos_ROOT and Kokkos_ROOT are set in the environment.",
      "inherits": "release-cuda-trilinos",
      "binaryDir": "build/release-cuda-trilinos-mpi",
      "cacheVariables": {
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/release-cuda-trilinos-mpi",
        "SPECFEM_ENABLE_MPI": "ON",
        "SPECFEM_BENCHMARKS_BUILD_DIR": "${sourceDir}/benchmarks/build/release-cuda-trilinos-mpi"
      }
    },
    {
      "name": "release-hip",
      "displayName": "Release -- HIP enabled",
