        "SPECFEM_INSTALL": "ON",
        "SPECFEM_BUILD_TESTS": "ON",
        "SPECFEM_BUILD_BENCHMARKS": "ON",
        "SPECFEM_BENCHMARKS_BUILD_DIR": "${sourceDir}/benchmarks/build/release-frontier"
      }
    },
    {
      "name": "release-io",
      "displayName": "Release -- SIMD and IO dependencies enabled",
      "description": "This preset is used for building with IO dependencies like ADIOS2 and HDF5.",
      "binaryDir": "build/release-io",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_INSTALL_PREFIX": "${sourceDir}/bin/release-io",
        "Kokkos_ARCH_NATIVE": "ON",
        "Kokkos_ENABLE_AGGRESSIVE_VECTORIZATION": "ON",
