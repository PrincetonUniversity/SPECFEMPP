        "Kokkos_ENABLE_HIP": "ON",
        "Kokkos_ARCH_ZEN3": "ON",
        "Kokkos_ARCH_VEGA90A": "ON",
        "Kokkos_ENABLE_AGGRESSIVE_VECTORIZATION": "ON",
